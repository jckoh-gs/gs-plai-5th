{
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "app",
            "env": [
              {
                "name": "KMA_AUTH_KEY",
                "valueFrom": {
                  "secretKeyRef": {
                    "name": "grid-kma",
                    "key": "auth-key",
                    "optional": true
                  }
                }
              }
            ]
          }
        ]
      }
    }
  }
}
