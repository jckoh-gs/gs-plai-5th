  "sentences": [
    {
      "sentence1": 1,
      "adoptedText": "측정한 값은 현재 선택한 단지와 발전기 상태를 보여줍니다.",
      "start": 0,
      "end": 4.5038125,
      "seconds": 4.5038125,
      "AIFFsha256": "bc33d3aa3ba1b28a10a5e6be67707be27c709b8e6d5ae8d85b2a9334286ae82c",
